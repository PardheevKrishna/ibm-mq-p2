# Copy this file to .env and fill in real values before running docker-compose.
# .env is git-ignored — never commit it.

# IBM MQ admin credentials (used by BCL RealAdapter to call MQ REST API)
BCL_MQ_USER=admin
BCL_MQ_PASSWORD=change_me

# IBM MQ container passwords (used by the MQ Docker images)
MQ_ADMIN_PASSWORD=change_me
MQ_APP_PASSWORD=change_me
